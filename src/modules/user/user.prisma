// type User {
//   id: ID!
//   name: String!
//   email: String!
//   avatar: String
//   posts: [Post!]!
//   comments: [Comment!]!
//   followers: [User!]!
//   following: [User!]!
// }
//
// Prisma has no block comments — only // and ///. A /** ... */ block is parsed
// as schema, so SDL notes written that way become real declarations and collide
// with the models below.

model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted Boolean  @default(false) @map("is_deleted")

  name   String
  email  String @unique
  avatar String @default("")

  // A user authors many posts and comments. The foreign key lives on the other
  // side, so these list fields take no fields/references arguments.
  posts    Post[]
  comments Comment[]

  // Implicit many-to-many self-relation: both sides share one relation name,
  // and Prisma manages the join table. Both must be declared.
  followers User[] @relation("UserFollows")
  following User[] @relation("UserFollows")

  @@map("users")
}
