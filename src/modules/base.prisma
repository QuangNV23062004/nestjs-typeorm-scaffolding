// Generator + datasource live here. Prisma reads `schema: 'src/modules'` from
// prisma.config.ts and picks up every *.prisma under it recursively, so each
// module keeps its own models next to its NestJS code.
//
// This file sits directly in src/modules/, not in a base/ subfolder, and must
// stay there. The Prisma VS Code extension ignores prisma.config.ts and infers
// the schema root by walking up from an open .prisma file for as long as the
// parent directory *directly* contains .prisma files. With every schema file
// nested one level deep, that walk stops at src/modules/<module>/ and each
// module is type-checked alone — cross-module references (User -> Post) show
// as unresolved even though the CLI validates fine. Keeping one .prisma here
// makes the walk reach src/modules/ and load the whole schema.
//
// Note: the connection URL is NOT declared here — Prisma 7 moved it to
// prisma.config.ts (datasource.url) and the runtime client takes an adapter.

// Output into node_modules/.prisma/client, which @prisma/client re-exports.
// That makes the import specifier bare ("@prisma/client"), so it resolves the
// same from src/ under ts-node and from dist/ after `nest build`. Emitting the
// client into src/ does not survive the build: it is plain .js that tsc will
// not compile and nest will not copy, so dist/ ends up without it.
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}
